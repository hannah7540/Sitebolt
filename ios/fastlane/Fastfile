default_platform(:ios)

platform :ios do
  desc "Archive com.sitebolt.app and upload to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("BUNDLE_ID", "com.sitebolt.app")
    build_number = ENV.fetch("BUILD_NUMBER", "1")
    output_dir = ENV.fetch("IPA_OUTPUT_DIR", "./build")
    profile_name = ENV.fetch("PROFILE_NAME")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "App/App.xcodeproj"
    )

    gym(
      project: "App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: output_dir,
      output_name: "SiteBolt.ipa",
      codesigning_identity: "Apple Distribution",
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        uploadSymbols: true,
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile_name}",
        "CODE_SIGN_IDENTITY=Apple Distribution",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
