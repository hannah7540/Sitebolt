# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Primary platform owner (seed:admin, password scripts)
MASTER_ADMIN_EMAIL=hannah@site-bolt.com.au
# MASTER_ADMIN_PASSWORD=your-dev-password

# Optional
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: NEXT_PUBLIC_SITE_URL=https://www.site-bolt.com.au
# NEXT_PUBLIC_APP_URL=https://www.site-bolt.com.au
# Email signature banner is hardcoded to public Supabase Storage:
# https://curuixppplfwwfmheflw.supabase.co/storage/v1/object/public/public-assets/SiteBold-Email-Banner.jpg

# Optional — Resend (expiry alerts, compliance notifications)
# RESEND_API_KEY=
# Sender override (defaults to Site Bolt <hannah@site-bolt.com.au>)
# NEXT_PUBLIC_FROM_EMAIL=
# SENDER_EMAIL=
# RESEND_FROM_EMAIL=
# EXPIRY_ALERT_FROM_EMAIL=hannah@site-bolt.com.au

# Optional — Twilio (SMS Communication Hub)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+61XXXXXXXXX
# Twilio inbound webhook URL: https://your-domain/api/sms/inbound
